# Runtime
NODE_ENV=development
PORT=3000

# MongoDB
CONNECTION_STRING=mongodb://127.0.0.1:27017/hagere

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_KEY=replace-with-cloudinary-api-key
CLOUDINARY_SECRET=replace-with-cloudinary-api-secret

# Firebase web API key (the frontend currently has its own Firebase config)
FIREBASE_API=replace-with-firebase-web-api-key

# Firebase Admin service-account JSON for the citizen authentication project.
# Replace every placeholder with the service account's actual fields.
SERVICE_ACCOUNT={"type":"service_account","project_id":"replace-with-project-id","private_key_id":"replace-with-private-key-id","private_key":"-----BEGIN PRIVATE KEY-----\\nreplace-with-private-key\\n-----END PRIVATE KEY-----\\n","client_email":"service-account@replace-with-project-id.iam.gserviceaccount.com","client_id":"replace-with-client-id"}

# Admin authentication is verified against a separate Firebase project.
ADMIN_FIREBASE_PROJECT_ID=hagere-admin
# Keep the service-account JSON on one line; its project_id must match above.
ADMIN_SERVICE_ACCOUNT={"type":"service_account","project_id":"hagere-admin","private_key_id":"replace-with-admin-private-key-id","private_key":"-----BEGIN PRIVATE KEY-----\\nreplace-with-admin-private-key\\n-----END PRIVATE KEY-----\\n","client_email":"service-account@hagere-admin.iam.gserviceaccount.com","client_id":"replace-with-admin-client-id"}
# Comma-separated Firebase Auth UIDs explicitly approved for administrative API access.
ADMIN_UIDS=replace-with-approved-admin-uid
